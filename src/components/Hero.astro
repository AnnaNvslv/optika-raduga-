---
import Icon from "./Icon.astro";
import { phones, whatsapp, address, hours, routeUrl } from "../data/contacts";
import { site } from "../data/site";
import { heroIconDataUri } from "../assets/images";

const whatsappHref = `${whatsapp.href}?text=${encodeURIComponent("Здравствуйте! Хочу узнать про очки в оптике Радуга.")}`;

const chips = [
  `Работаем с ${site.foundedYear} года`,
  "В одной минуте от метро",
  "Ремонтируем очки",
  "Устанавливаем линзы в оправу клиента",
];
---

<section class="hero" id="top">
  <div class="container hero__row">
    <div class="hero__copy">
      <p class="hero__brand">{site.brandName} · {site.brandTagline}</p>
      <h1>Очки для жизни, работы и чтения — без лишних переплат</h1>
      <p class="lede">
        Проверим зрение для подбора очков, поможем выбрать оправу и линзы под
        ваши задачи и бюджет. Работаем в Петербурге с {site.foundedYear} года.
      </p>

      <div class="hero__meta">
        <span><Icon name="pin" size={18} /> {address.metro}, {address.short}</span>
        <span><Icon name="route" size={18} /> {address.metroNote}, ориентир — ДК Газа</span>
        <span>
          <Icon name="clock" size={18} />
          {hours.map((h, i) => (
            <>
              {i > 0 && ", "}
              {h.label}: {h.value}
            </>
          ))}
        </span>
      </div>

      <div class="hero__actions">
        <a href={phones.landline.href} class="btn btn--primary">
          <Icon name="phone" size={20} /> Позвонить
        </a>
        <a href={whatsappHref} class="btn btn--secondary" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> Написать в WhatsApp
        </a>
        <a href={routeUrl} class="btn btn--ghost" target="_blank" rel="noopener">
          <Icon name="route" size={20} /> Как пройти
        </a>
      </div>

      <ul class="hero__chips">
        {chips.map((c) => (
          <li><Icon name="check" size={16} />{c}</li>
        ))}
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__blob">
        <img src={heroIconDataUri} width="220" height="220" alt="" loading="eager" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(36px, 6vw, 64px) var(--space-section);
  }

  .hero__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero__brand {
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 10px;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero__meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 22px 0 26px;
    color: var(--color-text-muted);
    font-size: 16px;
  }

  .hero__meta span {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero__meta :global(svg) {
    color: var(--color-primary);
    flex: none;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 26px;
  }

  .hero__chips {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero__chips li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 15.5px;
    color: var(--color-text);
  }

  .hero__chips :global(svg) {
    color: var(--color-accent-green);
    flex: none;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__blob {
    width: min(300px, 70vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      var(--color-primary-tint),
      var(--color-bg-alt) 70%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .hero__blob::before {
    content: "";
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    border: 3px dashed var(--color-border);
  }

  .hero__blob img {
    position: relative;
    width: 60%;
    height: auto;
  }

  @media (min-width: 960px) {
    .hero__row {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 56px;
    }
  }
</style>
