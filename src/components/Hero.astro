---
import Icon from "./Icon.astro";
import BrandCorner from "./BrandCorner.astro";
import { phones, whatsapp, address, hours, routeUrl } from "../data/contacts";
import { site } from "../data/site";

const whatsappHref = `${whatsapp.href}?text=${encodeURIComponent("Здравствуйте! Хочу узнать про очки в оптике Радуга.")}`;

// See CONTENT_TO_CONFIRM.md item 0/13: /images/hero.webp is a stock/illustrative
// placeholder, not a real photo of this shop. Swap it for real photography
// (the file itself, same path) whenever you have it — no code change needed.
const heroPhoto = "/images/hero.webp";

const chips = [
  `Работаем с ${site.foundedYear} года`,
  "В одной минуте от метро",
  "Ремонтируем очки",
  "Устанавливаем линзы в оправу клиента",
];
---

<section class="hero" id="top">
  <BrandCorner position="top-right" size={460} />
  <div class="container hero__row">
    <div class="hero__copy">
      <p class="hero__brand">{site.brandName} · {site.brandTagline}</p>
      <h1>Очки, которые подходят именно вам — без лишних переплат и уговоров</h1>
      <p class="lede">
        Спокойно разберёмся, что вам нужно, и подберём оправу и линзы под
        задачи и бюджет — без спешки и без давления. Работаем в Петербурге
        с {site.foundedYear} года.
      </p>

      <div class="hero__meta">
        <a href={routeUrl} target="_blank" rel="noopener" class="hero__meta-link">
          <Icon name="pin" size={18} /> {address.metro}, {address.short}
        </a>
        <span><Icon name="route" size={18} /> {address.metroNote}, ориентир — ДК Газа</span>
        <span>
          <Icon name="clock" size={18} />
          {hours.map((h, i) => (
            <>
              {i > 0 && ", "}
              {h.label}: {h.value}
            </>
          ))}
        </span>
      </div>

      <div class="hero__actions">
        <a href={phones.landline.href} class="btn btn--primary">
          <Icon name="phone" size={20} /> Позвонить
        </a>
        <a href={whatsappHref} class="btn btn--secondary" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> Написать в WhatsApp
        </a>
        <a href={routeUrl} class="btn btn--ghost" target="_blank" rel="noopener">
          <Icon name="route" size={20} /> Как пройти
        </a>
      </div>

      <ul class="hero__chips">
        {chips.map((c) => (
          <li><Icon name="check" size={16} />{c}</li>
        ))}
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__blob">
        <img src={heroPhoto} width="640" height="640" alt="" loading="eager" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(36px, 6vw, 64px) var(--space-section);
    overflow: hidden;
    position: relative;
  }

  .hero__row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero__brand {
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 10px;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero__meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 22px 0 26px;
    color: var(--color-text-muted);
    font-size: 16px;
  }

  .hero__meta span,
  .hero__meta-link {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero__meta-link {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .hero__meta-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .hero__meta :global(svg),
  .hero__meta-link :global(svg) {
    color: var(--color-primary);
    flex: none;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 26px;
  }

  .hero__chips {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero__chips li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 15.5px;
    color: var(--color-text);
  }

  .hero__chips :global(svg) {
    color: var(--color-accent-green);
    flex: none;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
    animation: heroFadeUp 0.9s ease 0.15s both;
  }

  .hero__blob {
    width: min(320px, 72vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-surface);
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    animation: heroBlobPulse 6s ease-in-out infinite;
    box-shadow: 0 20px 50px rgba(35, 38, 43, 0.12);
  }

  .hero__blob::before {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 3px dashed var(--color-border);
  }

  .hero__blob img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .hero__copy {
    animation: heroFadeUp 0.7s ease both;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes heroBlobPulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
  }

  @media (min-width: 960px) {
    .hero__row {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 56px;
    }
  }
</style>
