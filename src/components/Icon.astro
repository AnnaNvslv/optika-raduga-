---
// Small hand-drawn line-icon set (original, not copied from any icon
// library) so the site needs no icon-font or extra network request.
export interface Props {
  name:
    | "check-eye"
    | "glasses"
    | "monitor"
    | "swap"
    | "wrench"
    | "sun"
    | "phone"
    | "whatsapp"
    | "vk"
    | "mail"
    | "pin"
    | "route"
    | "clock"
    | "menu"
    | "close"
    | "chevron-down"
    | "check";
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;
---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "check-eye" && (
      <>
        <path d="M2 12c2.5-4 6.2-6 10-6s7.5 2 10 6c-2.5 4-6.2 6-10 6s-7.5-2-10-6Z" />
        <circle cx="12" cy="12" r="3" />
        <path d="M9.5 15.5 11 17l3.5-4" stroke-width="1.6" />
      </>
    )
  }
  {
    name === "glasses" && (
      <>
        <circle cx="6.5" cy="14" r="3.4" />
        <circle cx="17.5" cy="14" r="3.4" />
        <path d="M9.9 13.2h4.2M3.5 13 2 9M20.5 13 22 9" />
      </>
    )
  }
  {
    name === "monitor" && (
      <>
        <rect x="3" y="4.5" width="18" height="12" rx="1.6" />
        <path d="M8.5 20.5h7M12 16.5v4" />
      </>
    )
  }
  {
    name === "swap" && (
      <>
        <path d="M4 8h13M17 8l-3-3M17 8l-3 3" />
        <path d="M20 16H7M7 16l3-3M7 16l3 3" />
      </>
    )
  }
  {
    name === "wrench" && (
      <path d="M14.7 6.3a4 4 0 0 0-5.4 4.9L3 17.5 6.5 21l6.3-6.3a4 4 0 0 0 4.9-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6Z" />
    )
  }
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.5v2.4M12 19v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7" />
      </>
    )
  }
  {
    name === "phone" && (
      <path d="M5.3 3.5 8 3l1.7 4.1-1.7 1.7a12 12 0 0 0 5.2 5.2l1.7-1.7L19 14v2.7c0 .9-.8 1.6-1.7 1.5A16 16 0 0 1 4.2 5.2c-.1-.9.6-1.7 1.5-1.7Z" />
    )
  }
  {
    name === "whatsapp" && (
      <>
        <path d="M6.5 17.3 3.8 20l2.8-.8a8.4 8.4 0 1 0-3-3.1l-.1 1.2" />
        <path d="M8.8 8.6c.2-.5.6-.5.9-.5h.5c.2 0 .4 0 .6.5s.7 1.6.7 1.8.1.3 0 .5-.2.3-.4.5-.3.4-.1.7c.2.3.8 1.3 1.8 2.1 1.2 1 1.7 1.1 2 1.1s.4-.2.6-.4l.5-.6c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4s0 1-.5 1.5-1.3.9-2.3.7a7 7 0 0 1-4.3-2.6 7.4 7.4 0 0 1-1.9-4.3c0-1 .5-1.5.6-1.7Z" />
      </>
    )
  }
  {
    name === "vk" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M7.2 8.2c.2 4 2.2 6.4 5.6 6.4h.4v-2.3c1.2.1 2.1.9 2.5 2.3h2c-.4-2-1.9-3-2.9-3.4 1-.5 2.3-1.6 2.6-3h-1.9c-.4 1.4-1.5 2.5-2.3 2.6V8.1H11v4.8c-.8-.2-1.9-1.4-1.9-4.7H7.2Z" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 6.5 8 6.2 8-6.2" />
      </>
    )
  }
  {
    name === "pin" && (
      <>
        <path d="M12 21.5s7-6.3 7-11.7a7 7 0 1 0-14 0c0 5.4 7 11.7 7 11.7Z" />
        <circle cx="12" cy="9.8" r="2.4" />
      </>
    )
  }
  {
    name === "route" && (
      <>
        <circle cx="5.5" cy="6" r="2" />
        <circle cx="18.5" cy="18" r="2" />
        <path d="M5.5 8v3a3 3 0 0 0 3 3h5a3 3 0 0 1 3 3v1" />
      </>
    )
  }
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {
    name === "menu" && (
      <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" />
    )
  }
  {name === "close" && <path d="M5 5l14 14M19 5 5 19" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>
